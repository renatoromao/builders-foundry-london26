# ---------- mode
DEMO_MODE=mock                    # mock | live (live = real Fabric IQ / Work IQ through Foundry)
# FABRIC_IQ_MODE=mock             # per source override (defaults to DEMO_MODE)
# WORK_IQ_MODE=mock

# ---------- models (Microsoft Foundry project, Entra ID via `az login` — no keys)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4.1             # default for every agent
ORCHESTRATOR_MODEL=
DATA_ANALYST_MODEL=
DATA_ANALYST_MODEL_ALT=           # Demo 3 model comparison
WORK_CONTEXT_MODEL=
ACTION_MODEL=
# EVAL_JUDGE_MODEL=               # LLM judge for the Foundry evaluators (defaults to ORCHESTRATOR_MODEL)
# REASONING_EFFORT=low            # reasoning models (gpt-5, gpt-6…); classic models use AGENT_TEMPERATURE
# AGENT_TEMPERATURE=0.1

# ---------- live tools (preview)
FABRIC_IQ_MCP_URL=                # Fabric IQ ontology / data agent MCP endpoint, or a Foundry toolbox MCP URL
FABRIC_IQ_CONNECTION_ID=          # Foundry project connection (fabric_iq_preview)
WORK_IQ_CONNECTION_ID=            # Foundry project connection (work_iq_preview, A2A)
# WORK_IQ_MCP_URL=                # alternative: Foundry toolbox MCP endpoint with Work IQ

# ---------- reuse agents already built in the Foundry portal (optional)
# WORK_CONTEXT_FOUNDRY_AGENT=WorkAgent
# DATA_ANALYST_FOUNDRY_AGENT=DataAgent

# ---------- tracing
TRACING=auto                      # auto | foundry | otlp | off
APPLICATIONINSIGHTS_CONNECTION_STRING=
# ENABLE_SENSITIVE_DATA=true

# ---------- fallback model endpoints (bad Wi-Fi)
# MODEL_PROVIDER=foundry          # foundry | azure_openai | openai_compatible
# AZURE_OPENAI_ENDPOINT=
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama / Foundry Local
# OPENAI_API_KEY=local
